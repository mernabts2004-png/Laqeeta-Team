@{
    ViewData["Title"] = "حصل خطأ";
}

<div class="text-center py-5">
    <h1 class="display-6 fw-bold text-danger mb-3">حصل خطأ غير متوقع</h1>
    <p class="text-muted">جرّب تاني بعد شوية. لو المشكلة فضلت موجودة بلّغ فريق التطوير.</p>
    @if (ViewData["RequestId"] is string requestId)
    {
        <p class="small text-muted">رقم الطلب: <code>@requestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">الرجوع للرئيسية</a>
</div>
