<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - لقيطة</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark metro-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="metro-badge">M</span>
                <span>لقيطة</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="LostReports" asp-action="Create">بلّغ عن حاجة ضاعت</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Track" asp-action="Index">تابع بلاغك</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Claims" asp-action="Status">حالة طلب الاستلام</a>
                    </li>
                    @if (User.IsInRole("Staff"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-staff" asp-controller="Staff" asp-action="Index">لوحة الموظف</a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-staff" asp-controller="Admin" asp-action="Index">التقارير</a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white-50 small">أهلاً، @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-light">تسجيل الخروج</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">دخول الموظفين</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer py-4 mt-4">
        <div class="container text-center small">
            لقيطة — نظام المفقودات في مترو الأنفاق
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
